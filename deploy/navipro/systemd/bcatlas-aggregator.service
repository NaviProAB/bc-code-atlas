[Unit]
Description=bc-code-atlas aggregator, one /mcp endpoint (:8800)
After=network-online.target
Wants=network-online.target
PartOf=bcatlas.target
ConditionPathExists=/var/lib/bcatlas/indexed

[Service]
User=bcatlas
Group=bcatlas
WorkingDirectory=/opt/bcatlas/bc-code-atlas
Environment=PATH=/home/bcatlas/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/bcatlas
Environment=UV_PYTHON=3.13
ExecStart=/opt/bcatlas/bc-code-atlas/scripts/start-aggregator.sh
Restart=always
RestartSec=5

[Install]
WantedBy=bcatlas.target
